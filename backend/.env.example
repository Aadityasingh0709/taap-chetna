PORT=5000
# Local MongoDB
# MONGO_URI=mongodb://localhost:27017/tapchetna
# Cloud MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.xxxx.mongodb.net/tapchetna?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://127.0.0.1:5001
NODE_ENV=development

# Conversational AI Provider (ollama | groq)
AI_PROVIDER=ollama

# Local Ollama Configuration (Qwen3 4B)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Cloud GroqCloud Configuration (Alternative Provider)
# Obtain a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

